{
  "name": "stowplan",
  "version": "1.1.0",
  "description": "Truck and container load planner for touring production crews",
  "author": "Nick Snyder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64 --dir"
  },
  "build": {
    "appId": "com.audiorazor.stowplan",
    "productName": "StowPlan",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "StowPlan-${version}-Windows-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "StowPlan-Setup-Windows.${ext}"
    },
    "portable": {
      "artifactName": "StowPlan-Portable-Windows.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
